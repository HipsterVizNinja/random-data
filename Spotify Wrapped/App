import React, { useState } from 'react';
import { Download, Music, AlertCircle, CheckCircle } from 'lucide-react';

const SpotifyWrappedExporter = () => {
  const [status, setStatus] = useState('idle');
  const [error, setError] = useState('');
  const [trackCount, setTrackCount] = useState(0);

  // Replace these with your Spotify app credentials
  const CLIENT_ID = 'e74f81b35d134cabb241a97989c71010';
  const REDIRECT_URI = window.location.origin + window.location.pathname;
  const SCOPES = 'playlist-read-private playlist-read-collaborative';

  const generateRandomString = (length) => {
    const possible = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    return Array.from(crypto.getRandomValues(new Uint8Array(length)))
      .map((x) => possible[x % possible.length])
      .join('');
  };

  const sha256 = async (plain) => {
    const encoder = new TextEncoder();
    const data = encoder.encode(plain);
    return window.crypto.subtle.digest('SHA-256', data);
  };

  const base64urlencode = (a) => {
    return btoa(String.fromCharCode.apply(null, new Uint8Array(a)))
      .replace(/\+/g, '-')
      .replace(/\//g, '_')
      .replace(/=+$/, '');
  };

  const handleLogin = async () => {
    const codeVerifier = generateRandomString(64);
    const hashed = await sha256(codeVerifier);
    const codeChallenge = base64urlencode(hashed);

    sessionStorage.setItem('code_verifier', codeVerifier);

    const authUrl = new URL('https://accounts.spotify.com/authorize');
    authUrl.searchParams.append('client_id', CLIENT_ID);
    authUrl.searchParams.append('response_type', 'code');
    authUrl.searchParams.append('redirect_uri', REDIRECT_URI);
    authUrl.searchParams.append('scope', SCOPES);
    authUrl.searchParams.append('code_challenge_method', 'S256');
    authUrl.searchParams.append('code_challenge', codeChallenge);

    window.location.href = authUrl.toString();
  };

  const getAccessToken = async (code) => {
    const codeVerifier = sessionStorage.getItem('code_verifier');

    const response = await fetch('https://accounts.spotify.com/api/token', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: new URLSearchParams({
        client_id: CLIENT_ID,
        grant_type: 'authorization_code',
        code: code,
        redirect_uri: REDIRECT_URI,
        code_verifier: codeVerifier,
      }),
    });

    return response.json();
  };

  const findWrappedPlaylist = async (accessToken) => {
    let url = 'https://api.spotify.com/v1/me/playlists?limit=50';
    
    while (url) {
      const response = await fetch(url, {
        headers: { Authorization: `Bearer ${accessToken}` },
      });
      
      const data = await response.json();
      
      const wrapped = data.items.find(p => 
        p.name.toLowerCase().includes('wrapped') && 
        p.name.includes('2025')
      );
      
      if (wrapped) return wrapped;
      
      url = data.next;
    }
    
    return null;
  };

  const getAllPlaylistTracks = async (playlistId, accessToken) => {
    let allTracks = [];
    let url = `https://api.spotify.com/v1/playlists/${playlistId}/tracks?limit=50`;
    
    while (url) {
      const response = await fetch(url, {
        headers: { Authorization: `Bearer ${accessToken}` },
      });
      
      const data = await response.json();
      allTracks.push(...data.items.filter(item => item.track));
      url = data.next;
    }
    
    return allTracks;
  };

  const getAudioFeatures = async (trackIds, accessToken) => {
    const batches = [];
    
    for (let i = 0; i < trackIds.length; i += 100) {
      const batch = trackIds.slice(i, i + 100);
      const ids = batch.join(',');
      
      const response = await fetch(
        `https://api.spotify.com/v1/audio-features?ids=${ids}`,
        { headers: { Authorization: `Bearer ${accessToken}` } }
      );
      
      const data = await response.json();
      batches.push(...(data.audio_features || []));
    }
    
    return batches;
  };

  const exportToCSV = (data) => {
    const headers = [
      'name', 'artists', 'album', 'release_date', 'duration_ms', 'popularity',
      'danceability', 'energy', 'key', 'loudness', 'mode', 'speechiness',
      'acousticness', 'instrumentalness', 'liveness', 'valence', 'tempo', 'time_signature'
    ];

    const csvRows = [headers.join(',')];

    data.forEach(row => {
      const values = headers.map(header => {
        const value = row[header] ?? '';
        const escaped = String(value).replace(/"/g, '""');
        return `"${escaped}"`;
      });
      csvRows.push(values.join(','));
    });

    const csvContent = csvRows.join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'spotify_wrapped_2025.csv';
    a.click();
    window.URL.revokeObjectURL(url);
  };

  const processData = async () => {
    try {
      setStatus('processing');
      setError('');

      const urlParams = new URLSearchParams(window.location.search);
      const code = urlParams.get('code');

      if (!code) {
        throw new Error('No authorization code found');
      }

      const tokenData = await getAccessToken(code);
      const accessToken = tokenData.access_token;

      setStatus('finding');
      const playlist = await findWrappedPlaylist(accessToken);

      if (!playlist) {
        throw new Error('Could not find your Wrapped 2025 playlist. Make sure Spotify has created it.');
      }

      setStatus('fetching');
      const tracks = await getAllPlaylistTracks(playlist.id, accessToken);
      setTrackCount(tracks.length);

      const trackIds = tracks.map(item => item.track.id);
      const audioFeatures = await getAudioFeatures(trackIds, accessToken);

      const completeData = tracks.map((item, index) => {
        const track = item.track;
        const features = audioFeatures[index] || {};

        return {
          name: track.name,
          artists: track.artists.map(a => a.name).join(', '),
          album: track.album.name,
          release_date: track.album.release_date,
          duration_ms: track.duration_ms,
          popularity: track.popularity,
          danceability: features.danceability,
          energy: features.energy,
          key: features.key,
          loudness: features.loudness,
          mode: features.mode,
          speechiness: features.speechiness,
          acousticness: features.acousticness,
          instrumentalness: features.instrumentalness,
          liveness: features.liveness,
          valence: features.valence,
          tempo: features.tempo,
          time_signature: features.time_signature,
        };
      });

      exportToCSV(completeData);
      setStatus('complete');

      window.history.replaceState({}, document.title, window.location.pathname);
      sessionStorage.removeItem('code_verifier');

    } catch (err) {
      setError(err.message);
      setStatus('error');
    }
  };

  React.useEffect(() => {
    const urlParams = new URLSearchParams(window.location.search);
    const code = urlParams.get('code');

    if (code && status === 'idle') {
      processData();
    }
  }, []);

  return (
    <div className="min-h-screen bg-gradient-to-br from-green-400 via-green-500 to-green-600 flex items-center justify-center p-4">
      <div className="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full">
        <div className="text-center mb-8">
          <div className="inline-flex items-center justify-center w-16 h-16 bg-green-500 rounded-full mb-4">
            <Music className="w-8 h-8 text-white" />
          </div>
          <h1 className="text-3xl font-bold text-gray-800 mb-2">
            Spotify Wrapped Exporter
          </h1>
          <p className="text-gray-600">
            Export your Wrapped 2025 playlist data with full audio features
          </p>
        </div>

        {status === 'idle' && (
          <div className="space-y-4">
            <button
              onClick={handleLogin}
              className="w-full bg-green-500 hover:bg-green-600 text-white font-semibold py-3 px-6 rounded-lg transition-colors flex items-center justify-center gap-2"
            >
              <Music className="w-5 h-5" />
              Connect to Spotify
            </button>
            <div className="text-sm text-gray-500 text-center">
              You'll need to add your Spotify Client ID to use this app
            </div>
          </div>
        )}

        {status === 'processing' && (
          <div className="text-center py-8">
            <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-green-500 mx-auto mb-4"></div>
            <p className="text-gray-600">Authenticating...</p>
          </div>
        )}

        {status === 'finding' && (
          <div className="text-center py-8">
            <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-green-500 mx-auto mb-4"></div>
            <p className="text-gray-600">Finding your Wrapped playlist...</p>
          </div>
        )}

        {status === 'fetching' && (
          <div className="text-center py-8">
            <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-green-500 mx-auto mb-4"></div>
            <p className="text-gray-600">
              Fetching data for {trackCount} tracks...
            </p>
          </div>
        )}

        {status === 'complete' && (
          <div className="text-center py-8">
            <div className="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
              <CheckCircle className="w-10 h-10 text-green-500" />
            </div>
            <h2 className="text-2xl font-bold text-gray-800 mb-2">Success!</h2>
            <p className="text-gray-600 mb-6">
              Your CSV file has been downloaded
            </p>
            <button
              onClick={() => setStatus('idle')}
              className="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-6 rounded-lg transition-colors"
            >
              Done
            </button>
          </div>
        )}

        {status === 'error' && (
          <div className="text-center py-8">
            <div className="inline-flex items-center justify-center w-16 h-16 bg-red-100 rounded-full mb-4">
              <AlertCircle className="w-10 h-10 text-red-500" />
            </div>
            <h2 className="text-2xl font-bold text-gray-800 mb-2">Error</h2>
            <p className="text-gray-600 mb-6">{error}</p>
            <button
              onClick={() => {
                setStatus('idle');
                setError('');
              }}
              className="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-6 rounded-lg transition-colors"
            >
              Try Again
            </button>
          </div>
        )}

        <div className="mt-8 pt-6 border-t border-gray-200">
          <h3 className="font-semibold text-gray-800 mb-2">Setup Required:</h3>
          <ol className="text-sm text-gray-600 space-y-2">
            <li>1. Create a Spotify app at developer.spotify.com</li>
            <li>2. Add this URL as a redirect URI in your app settings</li>
            <li>3. Replace YOUR_CLIENT_ID_HERE in the code with your Client ID</li>
          </ol>
        </div>
      </div>
    </div>
  );
};

export default SpotifyWrappedExporter;